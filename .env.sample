# Copy this file to `.env` in the repository root (`cp .env.sample .env`).
#
# `.env` is git-ignored on purpose: it is machine-local and must never carry a secret.
# The application itself does NOT read this file at runtime — it resolves its data
# directory from `src-tauri/src/db.rs`. `.env` exists for the developer tools below.
#
# The hygiene gate (`scripts/harness/check-hygiene.sh`) fails if `.env` is tracked again,
# or if `.env` uses a key that is not listed here.

# Consumed by the `diesel` CLI (`diesel migration run`, `diesel print-schema`).
# Point it at the local development database. The filename matches what the debug build
# uses (`local.pastebar-db.data`), so migrations apply to the database the dev app opens.
DATABASE_URL=sqlite://local.pastebar-db.data

# Consumed by `src-tauri/src/commands/translations_commands.rs` when writing translation
# updates produced by the in-app translation workflow. Relative to the repository root.
# Leave empty to disable writing translation files.
MISSING_TRANSLATION_SAVE_PATH=
