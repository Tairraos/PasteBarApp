    "@tanstack/react-query": "5.25.0",
    "@tanstack/react-query-devtools": "5.25.0",
    "@tauri-apps/api": "^1.6.0",
    "@types/node": "^20.10.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "codemirror": "^5.65.16",
    "date-fns": "^2.30.0",
    "dayjs": "^1.11.10",
    "dompurify": "^3.0.11",
    "dot-prop": "^8.0.2",
    "emoji-picker-react": "^4.5.16",
    "glob-all": "^3.3.1",
