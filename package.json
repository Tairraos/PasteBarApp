{
  "name": "pastebar-app",
  "version": "0.7.3",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "start": "tauri dev",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "test": "bash scripts/harness/run-tests.sh",
    "test:rust": "cd src-tauri && cargo test",
    "check": "bash scripts/harness/check-all.sh",
    "check:fast": "bash scripts/harness/check-all.sh --fast",
    "harness:scan": "bash scripts/harness/scan.sh",
    "harness:ipc": "node scripts/harness/gen-ipc-contract.mjs",
    "harness:reach": "node scripts/harness/reachability.mjs",
    "tauri": "tauri",
    "format": "npx prettier --write . --ignore-path .prettierignore",
    "build": "npm run app:build",
    "app:build": "node scripts/build-app.mjs",
    "app:build:osx:universal": "tauri build --config src-tauri/tauri.release.conf.json --target universal-apple-darwin",
    "app:build:osx:x86_64": "tauri build --config src-tauri/tauri.release.conf.json --target x86_64-apple-darwin",
    "app:build:windows:arm": "tauri build --config src-tauri/tauri.release.conf.json --target aarch64-pc-windows-msvc",
    "diesel:migration:run": "diesel migration run",
    "taze": "taze major -I",
    "taze:minor": "taze minor -w",
    "changeset": "changeset",
    "version:sync": "node scripts/sync-version.js",
    "version": "changeset version && npm run version:sync",
    "translation-audit": "npx tsx scripts/translation-audit.ts",
    "app:build:no-bump": "node scripts/build-app.mjs --no-bump"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
